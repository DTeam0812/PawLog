        },
        {
            "type": "java",
            "name": "Main",
            "request": "launch",
            "mainClass": "com.pawlog.client.collector.tracker.Main",
            "projectName": "pawlog-client"
        },
        {
            "type": "java",
            "name": "Widget",
            "request": "launch",
            "mainClass": "com.pawlog.client.ui.widget.Widget",
            "projectName": "pawlog-client"
        },
        {
            "type": "java",
            "name": "Widget",
            "request": "launch",
            "mainClass": "Widget"
        },
        {
            "type": "java",
            "name": "Windows API 실행",
            "request": "launch",
            "mainClass": "Main",
            "vmArgs": "--enable-native-access=ALL-UNNAMED"
        }
